
<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="ELibrary.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>InternshipELib | E-Library Management System</title>
    
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
        href="<%= ResolveUrl("~/Content/elibrary-ui.css") %>" />

    <link rel="stylesheet"
        href="<%= ResolveUrl("~/Content/ocean-teal-shell.css") %>" />

    <asp:ContentPlaceHolder
        ID="head"
        runat="server" />
</head>

<body id="pageBody" runat="server">

    <form id="form1" runat="server">

        <!-- ADMIN MOBILE BACKDROP -->
        <div id="elAdminBackdrop"
             class="el-shell-backdrop"
             aria-hidden="true"
             onclick="closeAdminSidebar()">
        </div>

        <!-- ADMIN SIDEBAR -->
        <asp:Panel
            ID="pnlAdminSidebar"
            runat="server"
            CssClass="el-sidebar el-ocean-sidebar"
            Visible="false">

            <div class="el-sidebar-brand el-ocean-brand">

                <asp:HyperLink
                    runat="server"
                    NavigateUrl="~/AdminHome.aspx"
                    CssClass="el-ocean-brand-link">

                    <span class="el-brand-logo">EL</span>

                    <span class="el-ocean-brand-copy">
                        <strong class="el-brand-name">
                            InternshipELib
                        </strong>

                        <small class="el-brand-caption">
                            Administration Workspace
                        </small>
                    </span>

                </asp:HyperLink>

                <button
                    type="button"
                    class="el-ocean-sidebar-close"
                    aria-label="Close navigation"
                    onclick="closeAdminSidebar()">
                    &times;
                </button>

            </div>

            <div class="el-sidebar-scroll">

                <div class="el-menu-label">
                    OVERVIEW
                </div>

                <asp:HyperLink
                    ID="navAdminDashboard"
                    runat="server"
                    NavigateUrl="~/AdminHome.aspx"
                    CssClass="el-menu-link"
                    Text="Dashboard" />

                <div class="el-menu-label">
                    MANAGEMENT
                </div>

                <!-- LIBRARY -->
                <button
                    type="button"
                    class="el-menu-group-toggle"
                    data-el-group="library"
                    aria-expanded="false"
                    aria-controls="el-group-library">

                    <span>Library Management</span>

                    <span class="el-menu-chevron"
                          aria-hidden="true">&#9662;</span>
                </button>

                <div id="el-group-library"
                     class="el-menu-group-content"
                     hidden>

                    <asp:HyperLink
                        ID="navManageBooks"
                        runat="server"
                        NavigateUrl="~/Admin/Books/ManageBooks.aspx"
                        CssClass="el-menu-link"
                        Text="Manage Books" />

                    <asp:HyperLink
                        ID="navManageGenres"
                        runat="server"
                        NavigateUrl="~/Admin/Books/ManageGenres.aspx"
                        CssClass="el-menu-link"
                        Text="Manage Genres" />

                </div>

                <!-- BORROWINGS -->
                <button
                    type="button"
                    class="el-menu-group-toggle"
                    data-el-group="borrowing"
                    aria-expanded="false"
                    aria-controls="el-group-borrowing">

                    <span>Borrowing Management</span>

                    <span class="el-menu-chevron"
                          aria-hidden="true">&#9662;</span>
                </button>

                <div id="el-group-borrowing"
                     class="el-menu-group-content"
                     hidden>

                    <asp:HyperLink
                        ID="navManageBorrows"
                        runat="server"
                        NavigateUrl="~/Admin/Borrowing/ManageBorrows.aspx"
                        CssClass="el-menu-link"
                        Text="Manage Borrowings" />

                    <asp:HyperLink
                        ID="navWalkInBorrow"
                        runat="server"
                        NavigateUrl="~/Admin/Borrowing/WalkInBorrow.aspx"
                        CssClass="el-menu-link"
                        Text="Walk-in Borrowing" />

                    <asp:HyperLink
                        ID="navOverdueBooks"
                        runat="server"
                        NavigateUrl="~/Admin/Borrowing/OverdueBooks.aspx"
                        CssClass="el-menu-link"
                        Text="Overdue Books" />

                    <asp:HyperLink
                        ID="navBorrowHistory"
                        runat="server"
                        NavigateUrl="~/Admin/Borrowing/BorrowHistory.aspx"
                        CssClass="el-menu-link"
                        Text="Borrow History" />

                </div>

                <!-- FINANCES -->
                <button
                    type="button"
                    class="el-menu-group-toggle"
                    data-el-group="finance"
                    aria-expanded="false"
                    aria-controls="el-group-finance">

                    <span>Financial Management</span>

                    <span class="el-menu-chevron"
                          aria-hidden="true">&#9662;</span>
                </button>

                <div id="el-group-finance"
                     class="el-menu-group-content"
                     hidden>

                    <asp:HyperLink
                        ID="navTransactions"
                        runat="server"
                        NavigateUrl="~/Admin/Transactions/ManageTransactions.aspx"
                        CssClass="el-menu-link"
                        Text="Manage Transactions" />

                </div>

                <!-- USERS -->
                <button
                    type="button"
                    class="el-menu-group-toggle"
                    data-el-group="users"
                    aria-expanded="false"
                    aria-controls="el-group-users">

                    <span>User Management</span>

                    <span class="el-menu-chevron"
                          aria-hidden="true">&#9662;</span>
                </button>

                <div id="el-group-users"
                     class="el-menu-group-content"
                     hidden>

                    <asp:HyperLink
                        ID="navManageUsers"
                        runat="server"
                        NavigateUrl="~/Admin/Users/ManageUsers.aspx"
                        CssClass="el-menu-link"
                        Text="Manage Users" />

                </div>

                <!-- RECORDS -->
                <button
                    type="button"
                    class="el-menu-group-toggle"
                    data-el-group="records"
                    aria-expanded="false"
                    aria-controls="el-group-records">

                    <span>Records &amp; Monitoring</span>

                    <span class="el-menu-chevron"
                          aria-hidden="true">&#9662;</span>
                </button>

                <div id="el-group-records"
                     class="el-menu-group-content"
                     hidden>

                    <asp:HyperLink
                        ID="navArchivedBooks"
                        runat="server"
                        NavigateUrl="~/Admin/Archive/ArchiveBooks.aspx"
                        CssClass="el-menu-link"
                        Text="Archived Books" />

                    <asp:HyperLink
                        ID="navAuditLogs"
                        runat="server"
                        NavigateUrl="~/Admin/Audit/AuditLogs.aspx"
                        CssClass="el-menu-link"
                        Text="Audit Logs" />

                </div>

            </div>

            <div class="el-sidebar-footer">

                <div class="el-ocean-sidebar-footer-label">
                    LIBRARY ADMINISTRATION
                </div>

                <asp:HyperLink
                    runat="server"
                    NavigateUrl="~/Logout.aspx"
                    CssClass="el-menu-link el-signout"
                    Text="Sign Out" />

            </div>

        </asp:Panel>

        <!-- ADMIN TOPBAR -->
        <asp:Panel
            ID="pnlAdminHeader"
            runat="server"
            CssClass="el-admin-header el-ocean-admin-header"
            Visible="false">

            <div class="el-header-left">

                <button
                    type="button"
                    class="el-ocean-menu-button"
                    aria-label="Open or close navigation"
                    aria-controls="pnlAdminSidebar"
                    aria-expanded="false"
                    onclick="toggleSidebar()">
                    <span aria-hidden="true">&#9776;</span>
                </button>

                <div class="el-header-title">
                    <strong>Administration</strong>
                    <span>E-Library Management Workspace</span>
                </div>

            </div>

            <div class="el-header-right">

                <asp:HyperLink
                    runat="server"
                    NavigateUrl="~/AdminHome.aspx"
                    CssClass="el-header-link"
                    Text="Dashboard" />

                <asp:HyperLink
                    runat="server"
                    NavigateUrl="~/Logout.aspx"
                    CssClass="el-header-link el-header-logout"
                    Text="Sign Out" />

                <asp:Image
                    ID="imgAdminAvatar"
                    runat="server"
                    CssClass="el-user-avatar el-avatar-image"
                    AlternateText="Administrator profile picture" />

            </div>

        </asp:Panel>

        <!-- GUEST / CUSTOMER HEADER -->
        <asp:Panel
            ID="pnlPublicHeader"
            runat="server"
            CssClass="el-public-header el-ocean-public-header">

            <asp:HyperLink
                ID="lnkPublicBrand"
                runat="server"
                NavigateUrl="~/Default.aspx"
                CssClass="el-public-brand"
                Text="InternshipELib" />

            <!-- GUEST NAVIGATION -->
            <nav class="el-public-nav"
                 aria-label="Guest navigation">

                <asp:PlaceHolder
                    ID="phGuestNavigation"
                    runat="server">

                    <asp:HyperLink
                        runat="server"
                        NavigateUrl="~/Default.aspx"
                        Text="Home" />

                    <asp:HyperLink
                        runat="server"
                        NavigateUrl="~/Login.aspx"
                        Text="Login" />

                    <asp:HyperLink
                        runat="server"
                        NavigateUrl="~/Register.aspx"
                        Text="Register" />

                </asp:PlaceHolder>

            </nav>

            <!-- CUSTOMER NAVIGATION -->
            <asp:PlaceHolder
                ID="phCustomerNavigation"
                runat="server"
                Visible="false">

                <div class="el-customer-header-content">

                    <button
                        type="button"
                        class="el-customer-menu-toggle"
                        aria-label="Toggle customer navigation"
                        aria-controls="customerNav"
                        aria-expanded="false"
                        onclick="toggleCustomerMenu()">
                        &#9776;
                    </button>

                    <nav id="customerNav"
                         class="el-customer-nav"
                         aria-label="Customer navigation">

                        <asp:HyperLink
                            ID="navCustomerDashboard"
                            runat="server"
                            NavigateUrl="~/CustomerHome.aspx"
                            CssClass="el-customer-nav-link"
                            Text="Home" />

                        <asp:HyperLink
                            ID="navCustomerBooks"
                            runat="server"
                            NavigateUrl="~/Customer/Books.aspx"
                            CssClass="el-customer-nav-link"
                            Text="Browse Books" />

                        <asp:HyperLink
                            ID="navCustomerBorrows"
                            runat="server"
                            NavigateUrl="~/Customer/MyBorrows.aspx"
                            CssClass="el-customer-nav-link"
                            Text="My Borrowings" />

                        <asp:HyperLink
                            ID="navCustomerHistory"
                            runat="server"
                            NavigateUrl="~/Customer/BorrowHistory.aspx"
                            CssClass="el-customer-nav-link"
                            Text="History" />

                        <asp:HyperLink
                            ID="navCustomerTransactions"
                            runat="server"
                            NavigateUrl="~/Customer/MyTransactions.aspx"
                            CssClass="el-customer-nav-link"
                            Text="Transactions" />

                        <asp:HyperLink
                            ID="navCustomerProfile"
                            runat="server"
                            NavigateUrl="~/Customer/Profile.aspx"
                            CssClass="el-customer-nav-link"
                            Text="Profile" />

                        <asp:HyperLink
                            ID="navCustomerLogout"
                            runat="server"
                            NavigateUrl="~/Logout.aspx"
                            CssClass="el-customer-nav-link el-customer-logout"
                            Text="Logout" />

                    </nav>

                    <asp:HyperLink
                        ID="lnkCustomerAvatar"
                        runat="server"
                        NavigateUrl="~/Customer/Profile.aspx"
                        CssClass="el-customer-avatar-link">

                        <asp:Image
                            ID="imgCustomerAvatar"
                            runat="server"
                            CssClass="el-user-avatar el-avatar-image"
                            AlternateText="My profile picture" />

                    </asp:HyperLink>

                </div>

            </asp:PlaceHolder>

        </asp:Panel>

        <!-- MAIN CONTENT -->
        <main class="el-main">

            <asp:Panel
                ID="pnlAdminToolbar"
                runat="server"
                CssClass="el-page-toolbar"
                Visible="false">

                <asp:HyperLink
                    runat="server"
                    NavigateUrl="~/AdminHome.aspx"
                    CssClass="el-back-link"
                    Text="&#8592; Admin Dashboard" />

                <span class="el-toolbar-caption">
                    InternshipELib Administration
                </span>

            </asp:Panel>

            <div class="el-page-container">

                <asp:ContentPlaceHolder
                    ID="MainContent"
                    runat="server" />

            </div>

        </main>

        <footer class="el-footer">
            &copy; 2026 InternshipELib — E-Library Management System
        </footer>

    </form>

    <script type="text/javascript">
        (function () {
            var sidebar = document.querySelector(".el-ocean-sidebar");
            var backdrop = document.getElementById("elAdminBackdrop");
            var adminMenuButton = document.querySelector(".el-ocean-menu-button");
            var customerMenuButton = document.querySelector(".el-customer-menu-toggle");
            var customerNav = document.getElementById("customerNav");

            function setAdminMenu(open) {
                document.body.classList.toggle("el-sidebar-open", open);

                if (adminMenuButton) {
                    adminMenuButton.setAttribute(
                        "aria-expanded",
                        open ? "true" : "false"
                    );
                }

                if (backdrop) {
                    backdrop.setAttribute(
                        "aria-hidden",
                        open ? "false" : "true"
                    );
                }
            }

            window.toggleSidebar = function () {
                setAdminMenu(
                    !document.body.classList.contains("el-sidebar-open")
                );
            };

            window.closeAdminSidebar = function () {
                setAdminMenu(false);
            };

            window.toggleCustomerMenu = function () {
                if (!customerNav) {
                    return;
                }

                var open = !customerNav.classList.contains(
                    "el-customer-nav-open"
                );

                customerNav.classList.toggle(
                    "el-customer-nav-open", open
                );

                if (customerMenuButton) {
                    customerMenuButton.setAttribute(
                        "aria-expanded",
                        open ? "true" : "false"
                    );
                }
            };

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    setAdminMenu(false);

                    if (customerNav) {
                        customerNav.classList.remove(
                            "el-customer-nav-open"
                        );
                    }

                    if (customerMenuButton) {
                        customerMenuButton.setAttribute(
                            "aria-expanded", "false"
                        );
                    }
                }
            });

            document.addEventListener("click", function (event) {
                if (customerNav &&
                    customerMenuButton &&
                    !customerNav.contains(event.target) &&
                    !customerMenuButton.contains(event.target)) {

                    customerNav.classList.remove(
                        "el-customer-nav-open"
                    );

                    customerMenuButton.setAttribute(
                        "aria-expanded", "false"
                    );
                }

                if (window.innerWidth <= 991 &&
                    sidebar &&
                    adminMenuButton &&
                    document.body.classList.contains("el-sidebar-open") &&
                    !sidebar.contains(event.target) &&
                    !adminMenuButton.contains(event.target)) {

                    setAdminMenu(false);
                }
            });

            var groups = document.querySelectorAll(
                ".el-menu-group-toggle"
            );

            for (var i = 0; i < groups.length; i++) {
                (function (button) {
                    var key = button.getAttribute("data-el-group");
                    var panel = document.getElementById(
                        "el-group-" + key
                    );

                    if (!panel) {
                        return;
                    }

                    var saved = null;

                    try {
                        saved = localStorage.getItem(
                            "el-admin-group-" + key
                        );
                    } catch (error) {
                        saved = null;
                    }

                    var hasActiveLink =
                        !!panel.querySelector(".el-menu-link.active");

                    var expanded = saved === "open";

                    if (hasActiveLink) {
                        expanded = true;
                    }

                    function apply() {
                        panel.hidden = !expanded;

                        button.setAttribute(
                            "aria-expanded",
                            expanded ? "true" : "false"
                        );

                        button.classList.toggle(
                            "is-expanded", expanded
                        );
                    }

                    apply();

                    button.addEventListener("click", function () {
                        expanded = !expanded;
                        apply();

                        try {
                            localStorage.setItem(
                                "el-admin-group-" + key,
                                expanded ? "open" : "closed"
                            );
                        } catch (error) {
                            // Navigation still works if storage is disabled.
                        }
                    });

                })(groups[i]);
            }
        })();
    </script>

</body>
</html>
