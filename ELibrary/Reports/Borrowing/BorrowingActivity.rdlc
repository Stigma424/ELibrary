<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
	<AutoRefresh>0</AutoRefresh>
	<DataSources>
		<DataSource Name="BorrowingSource">
			<ConnectionProperties>
				<DataProvider>System.Data.DataSet</DataProvider>
				<ConnectString>Local Report Data</ConnectString>
			</ConnectionProperties>
			<rd:DataSourceID>62c9eb43-2911-4e08-b189-19ab56852241</rd:DataSourceID>
		</DataSource>
	</DataSources>
	<DataSets>
		<DataSet Name="BorrowingDataSet">
			<Fields>
				<Field Name="BorrowLogID">
					<DataField>BorrowLogID</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="BookTitle">
					<DataField>BookTitle</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="CustomerName">
					<DataField>CustomerName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="DateBorrowed">
					<DataField>DateBorrowed</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="DueDate">
					<DataField>DueDate</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="DateReturned">
					<DataField>DateReturned</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="Status">
					<DataField>Status</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="CollectionStatus">
					<DataField>CollectionStatus</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="BorrowChannel">
