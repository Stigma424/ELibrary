					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
				<Field Name="DepositRequired">
					<DataField>DepositRequired</DataField>
					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
			</Fields>
			<Query>
				<DataSourceName>BorrowingSource</DataSourceName>
				<CommandText>Local Report Data</CommandText>
			</Query>
		</DataSet>
	</DataSets>
	<Body>
