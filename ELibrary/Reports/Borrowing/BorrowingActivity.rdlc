							<SortExpressions>
								<SortExpression>
									<Value>=Fields!ReportStatus.Value</Value>
								</SortExpression>
							</SortExpressions>
							<Label>=Fields!ReportStatus.Value</Label>
						</ChartMember>
					</ChartMembers>
				</ChartCategoryHierarchy>
				<ChartSeriesHierarchy>
					<ChartMembers>
