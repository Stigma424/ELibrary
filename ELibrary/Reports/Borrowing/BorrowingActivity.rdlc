			<Chart Name="chtBorrowingStatus">
				<ChartCategoryHierarchy>
					<ChartMembers>
						<ChartMember>
							<Group Name="BorrowingStatusChartGroup">
								<GroupExpressions>
									<GroupExpression>=Fields!ReportStatus.Value</GroupExpression>
