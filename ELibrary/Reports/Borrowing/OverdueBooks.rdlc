									<FontSize>18pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#B94E49</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
				</Paragraphs>
				<Top>1.8in</Top>
				<Left>3.69in</Left>
				<Height>0.72in</Height>
				<Width>1.7in</Width>
				<Style>
					<BackgroundColor>#EFF6F7</BackgroundColor>
					<PaddingLeft>8pt</PaddingLeft>
					<PaddingTop>6pt</PaddingTop>
				</Style>
			</Textbox>

			<Textbox Name="kpiSevere">
				<CanGrow>false</CanGrow>
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>15+ DAYS LATE</Value>
								<Style>
									<FontSize>8pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#647F89</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>=Sum(IIF(Fields!DaysOverdue.Value &gt;= 15,1,0),"OverdueDataSet")</Value>
								<Style>
									<FontSize>18pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#B46C28</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
				</Paragraphs>
				<Top>1.8in</Top>
				<Left>5.46in</Left>
				<Height>0.72in</Height>
				<Width>1.7in</Width>
				<Style>
					<BackgroundColor>#EFF6F7</BackgroundColor>
					<PaddingLeft>8pt</PaddingLeft>
					<PaddingTop>6pt</PaddingTop>
				</Style>
			</Textbox>

			<Textbox Name="txtChartHeading">
				<CanGrow>false</CanGrow>
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>OVERDUE SEVERITY DISTRIBUTION</Value>
								<Style>
