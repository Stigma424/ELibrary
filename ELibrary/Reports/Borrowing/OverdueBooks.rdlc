<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
	<AutoRefresh>0</AutoRefresh>
	<DataSources>
		<DataSource Name="OverdueSource">
			<ConnectionProperties>
				<DataProvider>System.Data.DataSet</DataProvider>
				<ConnectString>Local Report Data</ConnectString>
			</ConnectionProperties>
			<rd:DataSourceID>29d7265f-61c7-43cf-b5f8-2c2a64968101</rd:DataSourceID>
		</DataSource>
	</DataSources>
	<DataSets>
		<DataSet Name="OverdueDataSet">
			<Fields>
				<Field Name="BorrowLogID">
					<DataField>BorrowLogID</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="BookTitle">
					<DataField>BookTitle</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="CustomerName">
					<DataField>CustomerName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="CustomerEmail">
					<DataField>CustomerEmail</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="DateBorrowed">
					<DataField>DateBorrowed</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="DueDate">
					<DataField>DueDate</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="DaysOverdue">
					<DataField>DaysOverdue</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="BorrowChannel">
					<DataField>BorrowChannel</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
			</Fields>
			<Query>
				<DataSourceName>OverdueSource</DataSourceName>
				<CommandText>Local Report Data</CommandText>
			</Query>
		</DataSet>
	</DataSets>
