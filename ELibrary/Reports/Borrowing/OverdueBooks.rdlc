				<Left>0.15in</Left>
				<Height>0.3in</Height>
				<Width>7in</Width>
				<Style/>
			</Textbox>

			<Chart Name="chtOverdueSeverity">
				<ChartCategoryHierarchy>
					<ChartMembers>
						<ChartMember>
							<Group Name="OverdueSeverityGroup">
								<GroupExpressions>
									<GroupExpression>=Switch(Fields!DaysOverdue.Value &lt;= 7,"1–7 days",Fields!DaysOverdue.Value &lt;= 14,"8–14 days",Fields!DaysOverdue.Value &lt;= 30,"15–30 days",True,"31+ days")</GroupExpression>
								</GroupExpressions>
							</Group>
							<Label>=Switch(Fields!DaysOverdue.Value &lt;= 7,"1–7 days",Fields!DaysOverdue.Value &lt;= 14,"8–14 days",Fields!DaysOverdue.Value &lt;= 30,"15–30 days",True,"31+ days")</Label>
						</ChartMember>
					</ChartMembers>
				</ChartCategoryHierarchy>
				<ChartSeriesHierarchy>
					<ChartMembers>
						<ChartMember>
							<Label>Overdue loans</Label>
						</ChartMember>
					</ChartMembers>
				</ChartSeriesHierarchy>
				<ChartData>
					<ChartSeriesCollection>
						<ChartSeries Name="OverdueLoans">
							<ChartDataPoints>
								<ChartDataPoint>
									<ChartDataPointValues>
										<Y>=Count(Fields!BorrowLogID.Value)</Y>
									</ChartDataPointValues>
									<Style>
										<Color>#168A91</Color>
									</Style>
								</ChartDataPoint>
							</ChartDataPoints>
							<Type>Column</Type>
							<Subtype>Plain</Subtype>
						</ChartSeries>
					</ChartSeriesCollection>
				</ChartData>
				<ChartAreas>
					<ChartArea Name="Default">
						<ChartCategoryAxes>
							<ChartAxis Name="Primary">
								<Style/>
							</ChartAxis>
						</ChartCategoryAxes>
						<ChartValueAxes>
							<ChartAxis Name="Primary">
								<Style/>
							</ChartAxis>
						</ChartValueAxes>
						<Style/>
					</ChartArea>
				</ChartAreas>
				<DataSetName>OverdueDataSet</DataSetName>
				<Top>3.1in</Top>
				<Left>0.15in</Left>
				<Height>2.1in</Height>
				<Width>7in</Width>
				<Style>
					<BackgroundColor>White</BackgroundColor>
				</Style>
			</Chart>

