				<Width>1.7in</Width>
				<Style>
					<BackgroundColor>#EFF6F7</BackgroundColor>
					<PaddingLeft>8pt</PaddingLeft>
					<PaddingTop>6pt</PaddingTop>
				</Style>
			</Textbox>

			<Textbox Name="kpiAverage">
				<CanGrow>false</CanGrow>
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>AVERAGE DAYS LATE</Value>
								<Style>
									<FontSize>7pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#647F89</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>=Format(Avg(Fields!DaysOverdue.Value,"OverdueDataSet"),"N1")</Value>
								<Style>
									<FontSize>18pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#168A91</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
				</Paragraphs>
				<Top>1.8in</Top>
				<Left>1.92in</Left>
				<Height>0.72in</Height>
				<Width>1.7in</Width>
				<Style>
					<BackgroundColor>#EFF6F7</BackgroundColor>
					<PaddingLeft>8pt</PaddingLeft>
					<PaddingTop>6pt</PaddingTop>
				</Style>
			</Textbox>

			<Textbox Name="kpiMaximum">
				<CanGrow>false</CanGrow>
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>MAXIMUM DAYS LATE</Value>
								<Style>
									<FontSize>7pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#647F89</Color>
								</Style>
