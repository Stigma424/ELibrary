<?xml version="1.0" encoding="utf-8"?>
<Report
 xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
 xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

	<AutoRefresh>0</AutoRefresh>

	<DataSources>
		<DataSource Name="AuditTrailSource">
			<ConnectionProperties>
				<DataProvider>System.Data.DataSet</DataProvider>
				<ConnectString>Local Report Data</ConnectString>
			</ConnectionProperties>
			<rd:DataSourceID>eb426138-d4f4-487d-8cc5-9330911a7890</rd:DataSourceID>
		</DataSource>
	</DataSources>

	<DataSets>
		<DataSet Name="AuditTrailSummaryDataSet">
			<Fields>
				<Field Name="LogID">
					<DataField>LogID</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="UserID">
					<DataField>UserID</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="ActionDate">
					<DataField>ActionDate</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="ActorName">
					<DataField>ActorName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="ActorRole">
					<DataField>ActorRole</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="ActionCategory">
					<DataField>ActionCategory</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="ActionDesc">
					<DataField>ActionDesc</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
			</Fields>
			<Query>
				<DataSourceName>AuditTrailSource</DataSourceName>
				<CommandText>Local Report Data</CommandText>
			</Query>
		</DataSet>
	</DataSets>

	<Body>
		<ReportItems>

