			<Chart Name="AuditCategoryChart">
				<ChartCategoryHierarchy>
					<ChartMembers>
						<ChartMember>
							<Group Name="AuditCategoryGroup">
								<GroupExpressions>
									<GroupExpression>=Fields!ActionCategory.Value</GroupExpression>
								</GroupExpressions>
							</Group>
							<SortExpressions>
								<SortExpression>
									<Value>=Fields!ActionCategory.Value</Value>
									<Direction>Ascending</Direction>
								</SortExpression>
							</SortExpressions>
							<Label>=Fields!ActionCategory.Value</Label>
						</ChartMember>
					</ChartMembers>
				</ChartCategoryHierarchy>

				<ChartSeriesHierarchy>
					<ChartMembers>
						<ChartMember>
							<Label>Audit Events</Label>
						</ChartMember>
					</ChartMembers>
				</ChartSeriesHierarchy>

				<ChartData>
					<ChartSeriesCollection>
						<ChartSeries Name="AuditEventCount">
							<ChartDataPoints>
								<ChartDataPoint>
									<ChartDataPointValues>
										<Y>=Count(Fields!LogID.Value)</Y>
									</ChartDataPointValues>
									<Style>
										<Color>#168A91</Color>
									</Style>
								</ChartDataPoint>
							</ChartDataPoints>
							<Type>Column</Type>
							<Subtype>Plain</Subtype>
						</ChartSeries>
					</ChartSeriesCollection>
				</ChartData>

				<ChartAreas>
					<ChartArea Name="Default">
						<ChartCategoryAxes>
							<ChartAxis Name="Primary">
								<Style/>
							</ChartAxis>
						</ChartCategoryAxes>
						<ChartValueAxes>
							<ChartAxis Name="Primary">
								<Style/>
							</ChartAxis>
						</ChartValueAxes>
						<Style/>
					</ChartArea>
				</ChartAreas>

				<DataSetName>AuditTrailSummaryDataSet</DataSetName>

				<Top>3.27in</Top>
				<Left>0.12in</Left>
				<Height>2.05in</Height>
				<Width>9.03in</Width>
				<Style>
					<BackgroundColor>White</BackgroundColor>
				</Style>
			</Chart>

