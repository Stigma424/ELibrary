					<DataField>DepositReceived</DataField>
					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
				<Field Name="DepositRefunded">
					<DataField>DepositRefunded</DataField>
					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
				<Field Name="DepositHeld">
					<DataField>DepositHeld</DataField>
					<rd:TypeName>System.Decimal</rd:TypeName>
				</Field>
				<Field Name="OutstandingFees">
					<DataField>OutstandingFees</DataField>
