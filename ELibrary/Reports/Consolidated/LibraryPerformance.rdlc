					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="CurrentlyOverdue">
					<DataField>CurrentlyOverdue</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="TotalBookTitles">
					<DataField>TotalBookTitles</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="TotalCopies">
