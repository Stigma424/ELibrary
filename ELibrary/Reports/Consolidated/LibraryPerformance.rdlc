			<Textbox Name="SnapshotInventory">
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>BOOK INVENTORY</Value>
								<Style>
									<FontSize>8pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#647F89</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>=First(Fields!TotalBookTitles.Value,"OverviewDataSet") &amp; " titles"</Value>
