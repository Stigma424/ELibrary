			<!-- REPORT NOTES -->

			<Textbox Name="ClosingNote">
				<CanGrow>true</CanGrow>
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>REPORTING NOTES</Value>
								<Style>
									<FontSize>10pt</FontSize>
									<FontWeight>Bold</FontWeight>
									<Color>#123B4A</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>1. Borrowing and reservation metrics use their recorded transaction dates. Fee payments and refunds use financial transaction dates. Audit metrics use audit timestamps.</Value>
								<Style>
									<FontSize>8pt</FontSize>
									<Color>#647F89</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>2. Inventory, currently overdue loans, security deposits held, and outstanding fees are current snapshots rather than reconstructed historical balances.</Value>
								<Style>
									<FontSize>8pt</FontSize>
									<Color>#647F89</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>3. Security deposits are refundable liabilities and are excluded from fee collection income. Popularity rankings exclude archived books and use the same eligibility rules as the individual reports.</Value>
								<Style>
									<FontSize>8pt</FontSize>
									<Color>#647F89</Color>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
