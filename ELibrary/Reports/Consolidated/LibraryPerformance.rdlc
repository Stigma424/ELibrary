						<Style/>
					</Paragraph>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>=First(Fields!AvailableCopies.Value,"OverviewDataSet") &amp; " of " &amp; First(Fields!TotalCopies.Value,"OverviewDataSet") &amp; " copies available"</Value>
