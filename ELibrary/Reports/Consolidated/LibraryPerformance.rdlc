					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="TotalBorrowingRecords">
					<DataField>TotalBorrowingRecords</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="CollectedBorrowings">
					<DataField>CollectedBorrowings</DataField>
					<rd:TypeName>System.Int32</rd:TypeName>
				</Field>
				<Field Name="OnlineCollected">
