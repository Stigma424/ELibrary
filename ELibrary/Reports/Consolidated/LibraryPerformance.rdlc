					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>="The figures below reflect the database state as of " &amp; Format(First(Fields!SnapshotAt.Value,"OverviewDataSet"),"MMM dd, yyyy hh:mm tt") &amp; ". They are not historical month-end balances."</Value>
